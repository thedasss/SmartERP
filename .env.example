# SmartERP Environment Variables
# Copy this file to .env and update the values for your local environment

# Database Configuration
DATABASE_URL=mysql+aiomysql://smarterp:password@localhost:3306/smarterp
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smarterp
MYSQL_USER=smarterp
MYSQL_PASSWORD=password

# Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis / Background tasks
REDIS_URL=redis://localhost:6379/0

# AI / Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration (if using standard Vite env vars)
VITE_API_BASE_URL=http://localhost:8000
